# ---------------------------------------------------------------------------
# Build output and dependencies. The per-SDK .gitignore files still exist and
# are authoritative for their own directory; this is the union, so that a build
# run from the repository root can never accidentally commit artifacts.
# ---------------------------------------------------------------------------

# JVM (Java) — Gradle
build/
.gradle/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar

# Node / TypeScript
node_modules/
dist/
*.tsbuildinfo
coverage/
.nyc_output/

# Go
coverage.out
go/examples/*/example
go/examples/*/example.exe

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
.claude/

# Local environment / secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
